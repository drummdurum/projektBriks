# Example environment variables for Railway deployment
# Copy this file and set the actual values

# Database (Railway will automatically set DATABASE_URL)
DATABASE_URL=postgresql://username:password@host:port/database

# Application
NODE_ENV=production
PORT=3000
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters

# Email Configuration (Required for booking notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=birgittesbriks@gmail.com
NOTIFICATION_EMAIL=birgittesbriks@gmail.com
# Optional second recipient for new-booking notifications
NOTIFICATION_EMAIL_2=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_private_password
RATE_LIMIT_MAX_REQUESTS=3

# Google Calendar webhook (one selected Google calendar)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_WEBHOOK_URL=https://www.birgittesbriks.dk/api/calendar/google/webhook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.birgittesbriks.dk/api/calendar/google/callback
# 64 hexadecimal characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional fallback for legacy/manual setup; normal OAuth stores the encrypted token in PostgreSQL.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_CHANNEL_ID=
GOOGLE_CALENDAR_CHANNEL_TOKEN=
GOOGLE_CALENDAR_RESOURCE_ID=
